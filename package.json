{
  "name": "@chronova/antigravity-plugin",
  "version": "1.0.7",
  "private": false,
  "description": "Chronova heartbeat tracking plugin for Antigravity — sends coding activity to your Chronova dashboard via chronova-cli",
  "keywords": [
    "ai-coding",
    "antigravity",
    "chronova",
    "coding-analytics",
    "developer-analytics",
    "gemini",
    "heartbeat",
    "wakatime"
  ],
  "homepage": "https://github.com/nx-solutions-ug/antigravity-plugin#readme",
  "bugs": {
    "url": "https://github.com/nx-solutions-ug/antigravity-plugin/issues"
  },
  "license": "MIT",
  "author": "nx-solutions-ug",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nx-solutions-ug/antigravity-plugin.git"
  },
  "files": [
    "dist",
    "plugin.json",
    "hooks.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run build",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --react-plugin --vitest-plugin --import-plugin",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "bun pm pack",
    "semantic-release": "semantic-release",
    "lint:fix": "oxlint --react-plugin --vitest-plugin --import-plugin --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^26.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "semantic-release": "^25.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.4.2"
}
